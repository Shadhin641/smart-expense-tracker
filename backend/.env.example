# Copy to .env and fill in. NEVER commit .env.
# Generate all secrets with:  python scripts/generate_secrets.py

DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=expense_tracker
DB_USER=expense_app
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer

# AES-256-GCM keyring: "kid:base64(32 random bytes)", comma separated. Rotate by adding k2 and switching the active id.
FIELD_ENCRYPTION_KEYS=
FIELD_ENCRYPTION_ACTIVE_KID=k1
# HMAC key for the tamper-evident audit chain (>= 32 random bytes, base64)
AUDIT_HMAC_KEY=

# Security policy
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFY_TTL_HOURS=24
TRUSTED_PROXY_COUNT=0          # >0 only when behind that many reverse proxies you control

# Browser / TLS
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
SECURE_SSL_REDIRECT=true       # set false only for plain-HTTP local runs with DJANGO_DEBUG=true
BEHIND_TLS_PROXY=false
LOG_LEVEL=INFO
